{
  "name": "threejs-field-grass",
  "version": "0.1.0",
  "description": "Interactive TSL grass for Three.js with deterministic scatter and responsive body wakes.",
  "license": "MIT",
  "author": "Matthew Kissinger",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matthew-kissinger/threejs-field-grass.git"
  },
  "homepage": "https://matthew-kissinger.github.io/threejs-field-grass/",
  "bugs": {
    "url": "https://github.com/matthew-kissinger/threejs-field-grass/issues"
  },
  "keywords": [
    "threejs",
    "tsl",
    "webgpu",
    "webgl2",
    "grass",
    "react-three-fiber",
    "procedural",
    "interactive-vegetation",
    "game-development"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/types/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "bake": "tsx tools/bake-demo.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build:lib": "vite build --config vite.config.ts && tsc -p tsconfig.build.json",
    "build:demo": "vite build --config vite.demo.config.ts",
    "build": "npm run typecheck && npm run build:lib && npm run build:demo",
    "preview": "vite preview --config vite.demo.config.ts",
    "test:package": "node tools/test-package.mjs",
    "test:browser": "node tools/demo-smoke.mjs",
    "test:webgpu": "node tools/webgpu-smoke.mjs",
    "capture:demo": "node tools/capture-demo.mjs",
    "capture:island": "node tools/capture-island.mjs",
    "capture:island:webgl2": "node tools/capture-island.mjs --webgl2-only",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "prepack": "npm run check"
  },
  "peerDependencies": {
    "@react-three/fiber": ">=9.0.0 <10.0.0",
    "react": ">=19.0.0 <20.0.0",
    "three": ">=0.185.0 <0.186.0"
  },
  "peerDependenciesMeta": {
    "@react-three/fiber": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-three/fiber": "9.7.0",
    "@eslint/js": "9.39.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "5.1.4",
    "eslint": "9.39.2",
    "globals": "16.4.0",
    "playwright": "1.62.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
